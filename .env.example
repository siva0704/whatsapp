# =============================================================================
# WA-Sim — WhatsApp Developer Emulator Configuration (Phase 2)
# Copy this file to .env and adjust parameters for your integration test suite.
# Your system under test connects ONLY through these settings—no real WhatsApp
# credentials or Meta Business accounts are required.
# =============================================================================

# Server listening port (serves both REST/WS backend and cloned WhatsApp Web UI)
PORT=3000

# Emulator variant: "business" (single WhatsApp Business sender console, default) or "personal"
EMULATOR_VARIANT="business"

# API token checked on external REST & Cloud API calls (Authorization: Bearer <token> or X-API-Key).
# Leave empty to disable auth checks in local CI sandboxes.
EMULATOR_API_KEY="wa-sim-local-dev-token"

# Outbound webhook target URL in your system under test.
# Receives Meta Cloud API JSON POST payloads signed with X-Hub-Signature-256 and X-WA-Signature.
# Example: EMULATOR_WEBHOOK_URL="http://localhost:4000/webhooks/whatsapp"
EMULATOR_WEBHOOK_URL=""

# HMAC-SHA256 signing secret sent via X-Hub-Signature-256 & X-WA-Signature on every webhook POST
# and validated on inbound calls that include X-Hub-Signature-256.
EMULATOR_WEBHOOK_SECRET="wa-sim-webhook-secret"

# Path to JSON persistence file for message history, contacts, opt-in logs, templates, broadcasts, and media index
EMULATOR_DATA_FILE="./data/emulator-state.json"

# Simulated single Business sender identity (leave empty to configure via UI/API)
EMULATOR_SELF_NAME=""
EMULATOR_SELF_PHONE=""

# Message delivery lifecycle delays (milliseconds) for outbound messages:
# queued -> sent (immediate) -> delivered -> read
EMULATOR_LIFECYCLE_DELIVERED_MS=450
EMULATOR_LIFECYCLE_READ_MS=1400

# Enforce the Meta 24-hour customer service window in Business mode (blocks non-template sends
# with Meta error 131047 when >24h have elapsed since the customer's last inbound message)
EMULATOR_ENFORCE_24H_WINDOW="true"

# Enforce contact opt-in/opt-out compliance in Business mode (blocks business-initiated templates
# with Meta error 131049 after STOP/UNSUBSCRIBE/OPT-OUT/STOPALL until START/SUBSCRIBE/OPT-IN/UNSTOP)
EMULATOR_ENFORCE_OPT_IN="true"

# Optional JSON object overriding per-conversation pricing rates (USD) for cost-testing
# EMULATOR_PRICING_RATES='{"MARKETING":0.025,"UTILITY":0.015,"AUTHENTICATION":0.0135,"SERVICE":0}'
EMULATOR_PRICING_RATES=""

# Optional JSON array of additional phone_number_id senders under this SINGLE Business account
# EMULATOR_PHONE_NUMBERS='[{"id":"<PHONE_NUMBER_ID>","phoneNumber":"<E164_PHONE>","displayName":"<DISPLAY_NAME>","webhookUrl":"http://localhost:4000/webhooks/whatsapp"}]'
EMULATOR_PHONE_NUMBERS=""

# Seed simulated personal client recipient numbers on boot / reset (optional)
# Path to a JSON seed file containing an array of client contact definitions
EMULATOR_CLIENT_SEED_FILE=""

# Optional deterministic auto-generated client count on boot / reset (default 0 = empty)
EMULATOR_CLIENT_SEED_COUNT=0

# Broadcast queue engine defaults (throughput msgs/sec and batch concurrency)
EMULATOR_BROADCAST_THROUGHPUT=25
EMULATOR_BROADCAST_CONCURRENCY=8

# Rate-limit simulation thresholds (returns Meta #130429 HTTP 429 or #131056 pair limit when exceeded)
EMULATOR_RATE_LIMIT_PER_SEC=80
EMULATOR_RATE_LIMIT_PER_MIN=1200
EMULATOR_PAIR_RATE_LIMIT_PER_MIN=15
EMULATOR_DAILY_TEMPLATE_LIMIT=1000

# Optional JSON array of extra preloaded simulated contacts merged on first boot / reset (E.164 phones)
# EMULATOR_PRELOADED_CONTACTS='[{"name":"<CONTACT_NAME>","phone":"<E164_PHONE>","optInStatus":"opted_in"}]'
EMULATOR_PRELOADED_CONTACTS=""

# Optional JSON array of configurable auto-reply rules (matchType: "contains" | "regex" | "exact")
# EMULATOR_AUTO_REPLY_RULES='[{"name":"Ping Check","pattern":"^ping$","matchType":"regex","reply":"pong","delayMs":600,"respectOptOut":true}]'
EMULATOR_AUTO_REPLY_RULES=""

# Runtime host URL injected by environment if hosted remotely
APP_URL="http://localhost:3000"
